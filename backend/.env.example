# Copy to .env and fill in real values. Never commit .env.

# dev | test | prod
APP_ENV=dev

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (quote-free, URL-encode any special characters in the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=legaldocreader

# Outside APP_ENV=dev the app refuses to start if this is missing, shorter than
# 32 characters, or still equal to the value below.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Argon2id work factors. The defaults below sit above the OWASP minimum
# (m=19 MiB, t=2, p=1); raise them if your server can afford it. The test suite
# overrides these with low values so it is not minutes of pure hashing.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Comma-separated list of allowed browser origins.
#
# Only needed when the browser calls the API cross-origin. The frontend dev
# server proxies /api to this backend (same origin), so for normal local work
# and for port forwarding the default is enough.
#
# If you instead expose the API on its own forwarded port and point
# VITE_API_BASE_URL at it, add that frontend origin here, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://<id>-5173.<region>.devtunnels.ms
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by pytest. The name MUST end in _test; the suite refuses to run
# otherwise and drops this database when it finishes.
TEST_MONGODB_DB_NAME=legaldocreader_test
